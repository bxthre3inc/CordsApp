# Environment template for GCP / VPS deployment
# All services marked (FOSS) can be self-hosted to eliminate SaaS costs.

# ── GCP Configuration ─────────────────────────────────────────────────────────
export GCP_PROJECT_ID="your-project-id"
export GCP_REGION="us-central1"
export GCP_ZONE="us-central1-a"

# ── Database — PostgreSQL (FOSS) ──────────────────────────────────────────────
# Self-host on a $6/mo Hetzner VPS, or use Cloud SQL for managed convenience.
export CLOUDSQL_INSTANCE_NAME="cords-postgres"
export CLOUDSQL_REGION="us-central1"
export CLOUDSQL_DATABASE="cords_db"
export CLOUDSQL_USER="postgres"
export CLOUDSQL_PASSWORD="your_generated_password_here"
export CLOUDSQL_CONNECTION_NAME="PROJECT:REGION:INSTANCE"

# ── Redis / Valkey (FOSS) ─────────────────────────────────────────────────────
# Valkey is the MIT-licensed Redis fork: https://valkey.io
# Required for distributed rate limiting across multiple backend instances.
# docker run -d -p 6379:6379 valkey/valkey
export REDIS_URL="redis://localhost:6379"

# ── Artifact Registry ─────────────────────────────────────────────────────────
export ARTIFACT_REGISTRY_REPO="cords-repo"
export ARTIFACT_REGISTRY_LOCATION="us-central1"

# ── Cloud Run Services ────────────────────────────────────────────────────────
export BACKEND_SERVICE_NAME="cords-backend"
export FRONTEND_SERVICE_NAME="cords-frontend"
export BACKEND_MEMORY="512Mi"
export BACKEND_CPU="1"
export FRONTEND_MEMORY="256Mi"
export FRONTEND_CPU="1"

# ── Backend Configuration ─────────────────────────────────────────────────────
export NODE_ENV="production"
export PORT="8080"
export JWT_SECRET="your_jwt_secret_key_here"
export JWT_EXPIRE="7d"

# ── Stripe (card processing — unavoidable for card rails) ─────────────────────
# Tip: enable ACH bank transfers in Stripe Dashboard to reduce fees to 0.8% capped $5.
export STRIPE_SECRET_KEY="sk_live_your_key_here"
export STRIPE_WEBHOOK_SECRET="whsec_your_key_here"
export STRIPE_PUBLISHABLE_KEY="pk_live_your_key_here"

# ── Application URLs ──────────────────────────────────────────────────────────
export API_URL="https://api.cords.example.com"
export APP_URL="https://cords.example.com"

# ── Email — Postal (FOSS self-hosted) ─────────────────────────────────────────
# Postal is a full transactional email server (MIT license): https://postalserver.io
# docker-compose setup: https://github.com/postalserver/postal
# Cheaper alternative: Stalwart Mail (all-in-one FOSS mail server)
# If unset, emails are only logged to console.
export SMTP_HOST="mail.yourdomain.com"
export SMTP_PORT="587"
export SMTP_SECURE="false"
export SMTP_USER="cords@yourdomain.com"
export SMTP_PASS="your_smtp_password"
export SMTP_FROM="Cords <noreply@yourdomain.com>"

# ── Error monitoring — GlitchTip (FOSS self-hosted Sentry) ────────────────────
# GlitchTip is an MIT-licensed Sentry alternative: https://glitchtip.com
# docker-compose in ~5 minutes, free self-hosted vs $29+/mo Sentry cloud.
export SENTRY_DSN="https://your_glitchtip_dsn_here"

# ── Analytics — Umami (FOSS self-hosted) ──────────────────────────────────────
# Umami: https://umami.is  (MIT license, replaces Google Analytics / Mixpanel)
# docker-compose: https://github.com/umami-software/umami
# export UMAMI_WEBSITE_ID="your-umami-website-id"

# ── Security / CORS ───────────────────────────────────────────────────────────
export CORS_ORIGIN="https://cords.example.com"

# ── Domain ────────────────────────────────────────────────────────────────────
export DOMAIN="cords.example.com"
export CUSTOM_DOMAIN_API="api.cords.example.com"
export CUSTOM_DOMAIN_FRONTEND="cords.example.com"
