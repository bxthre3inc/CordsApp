NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL — self-hosted or managed) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cords_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# ── Stripe (card processing — no FOSS alternative for card rails) ──────────────
# Use ACH bank transfers in checkout to reduce per-transaction cost (0.8%, capped $5)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Redis (FOSS — Valkey or Redis OSS) ────────────────────────────────────────
# Required for multi-instance production deployments (rate limiting)
# Self-host: docker run -p 6379:6379 valkey/valkey
# Leave unset to use in-memory fallback (single-process dev only)
# REDIS_URL=redis://localhost:6379

# ── Email (FOSS self-hosted SMTP — Postal recommended) ────────────────────────
# Postal: https://docs.postalserver.io  (full transactional email server, MIT license)
# Leave SMTP_HOST unset to disable emails (logged to console instead)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cords@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Cords <noreply@yourdomain.com>

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# ── Error monitoring (optional — GlitchTip is FOSS self-hosted Sentry) ────────
# GlitchTip: https://glitchtip.com  (self-host with docker-compose, MIT license)
# SENTRY_DSN=https://your_glitchtip_dsn_here
